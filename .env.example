# Copy to .env for the local stack (`cp .env.example .env`). Never commit .env.
# Local-only development values; production secrets live in the sops/age file (Story 1.2).

# Build version reported by GET /api/v1/health and /healthz
PSA_VERSION=0.1.0-local

# Postgres (compose `postgres` service)
# POSTGRES_USER and POSTGRES_PASSWORD are embedded unescaped in the api's database URL,
# so they must be URL-safe: no @ : / # % characters.
POSTGRES_USER=psa
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=psa
# Password of `psa_app`, the least-privileged role the api connects as (also URL-safe).
# Migrations run as POSTGRES_USER, the schema owner.
PSA_APP_DB_PASSWORD=change-me-app-local-only

# Host ports (bound to 127.0.0.1)
PSA_POSTGRES_PORT=5432
PSA_API_PORT=8000
PSA_WEB_PORT=3000

PSA_LOG_LEVEL=INFO

# Uploads (Story 2.1). Largest accepted file in bytes (52428800 = 50 MB), enforced by the
# api only. The web server's body limits (web/next.config.ts) sit just above 50 MB, so
# raising this past them also needs those raised.
PSA_UPLOAD_MAX_BYTES=52428800
# Knowledge Sources (Story 3.2). A Source not reviewed for this many months is flagged stale
# (derived, never stored). The signing key signs short-lived download links for earlier
# Source versions: set a random value (at least 16 characters) outside local use.
PSA_KNOWLEDGE_STALE_MONTHS=12
# Knowledge chunks (Story 3.3): target size and overlap in characters; the overlap must be
# less than half the size. Changing them affects newly embedded versions only.
PSA_KNOWLEDGE_CHUNK_CHARS=1500
PSA_KNOWLEDGE_CHUNK_OVERLAP_CHARS=200
PSA_DOWNLOAD_SIGNING_KEY=local-dev-download-signing-key-change-me
# Where the api stores uploaded files. In compose it is the `files` volume mounted at
# /var/lib/psa/files (set in compose.yaml); host-side runs (uvicorn, pytest) use this
# path, relative to backend/ (git-ignored).
PSA_STORAGE_DIR=var/files

# Worker (Story 2.2): the `worker` service claims and runs background jobs.
# Seconds to sleep (jittered) when no job is ready.
PSA_WORKER_POLL_S=1
# Jobs per worker process at a time. Reserved: only 1 is supported.
PSA_WORKER_CONCURRENCY=1
# A claimed job's lease, and how often a running job extends it (at most half the lease).
# A worker that dies mid-job loses its lease and the job is reclaimed after it expires.
PSA_JOB_LEASE_S=30
PSA_JOB_HEARTBEAT_S=10
# Source parsing (Story 2.2 Part B), in a child process per file: its wall-clock limit
# (at most 600 s) and, on Linux, its address-space limit.
PSA_PARSE_TIMEOUT_S=120
PSA_PARSE_MAX_MEMORY_MB=1024

# ModelGateway (Story 2.4): model calls go to the host's Ollama (`ollama serve`; cloud
# models also need `ollama signin`). Containers reach it through host.docker.internal;
# host-side tools (the smoke check, pytest) use http://127.0.0.1:11434 when this isn't exported.
PSA_OLLAMA_URL=http://host.docker.internal:11434
# Named profile for chat calls: demo-chat (gpt-oss:120b-cloud, num_ctx 32768), local-chat
# (qwen3:8b, num_ctx 16384) or local-chat-openai (qwen3:8b over the OpenAI-compatible adapter,
# see PSA_OPENAI_BASE_URL) or openai-chat (gpt-4.1-mini on OpenAI's cloud API: set
# PSA_OPENAI_BASE_URL=https://api.openai.com/v1 and PSA_OPENAI_API_KEY). DATA: demo-chat and
# openai-chat send prompt text to a cloud. Until IT approves that data handling, only sample
# or anonymised Opportunities may use them; use local-chat for anything else.
# Each Agent's config version in the Agent Registry pins its profile (seeded demo-chat).
# Setting PSA_MODEL_PROFILE_CHAT is a local-dev override of that registry profile for every
# Agent; leave it unset to use the pinned profiles.
# PSA_MODEL_PROFILE_CHAT=demo-chat
# OpenAI-compatible server (`/chat/completions`) for profiles with provider `openai`, e.g.
# local-chat-openai: vLLM or any /v1 server; the default is host Ollama's own /v1 endpoint
# (host-side tools use http://127.0.0.1:11434/v1 when this isn't exported). Such endpoints
# can't set the context size per request: the server must be configured with the profile's
# num_ctx (vLLM --max-model-len, Ollama OLLAMA_CONTEXT_LENGTH or a Modelfile).
PSA_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# Optional bearer key for that server (required for OpenAI's API); leave empty to send no
# Authorization header.
PSA_OPENAI_API_KEY=
# Optional model id for every `openai`-provider profile (local-chat-openai, openai-chat),
# replacing the profile's own, so switching model is only this line plus restarting api and
# worker: e.g. gpt-4.1, gpt-4.1-mini, gpt-4o, or a reasoning model with the line below.
# Empty keeps the profile's model. The model must support json_schema output.
PSA_OPENAI_MODEL=
# Set for a reasoning model (o3, o4-mini, gpt-5, ...): requests send this reasoning_effort
# (low, medium, high; minimal on gpt-5) and no temperature, which those models reject.
# Leave empty for a regular model. Reasoning is slower: raise PSA_MODEL_TIMEOUT_S if calls
# time out.
PSA_OPENAI_REASONING_EFFORT=
# Embedding profile for Knowledge chunks and search queries (Story 3.3): bge-m3 (1024 dims)
# on the Ollama server (`ollama pull bge-m3`). The api embeds search queries too, so both api
# and worker need PSA_OLLAMA_URL. Changing it needs a re-embed of every Source.
PSA_MODEL_PROFILE_EMBED=bge-m3
# Concurrent model calls per process; must be <= OLLAMA_NUM_PARALLEL on the Ollama server.
# 3 lets the Engineering, PM and Security Agents of an assessment run call at the same time.
PSA_MODEL_SLOTS=3
# Extra attempts after a reply that fails schema validation, and the per-request timeout.
PSA_MODEL_MAX_RETRIES=2
PSA_MODEL_TIMEOUT_S=120

# ToolGateway research fetch (Story 5.4): HTTPS pages from the hosts in
# ops/research-allowlist.yaml only (compose mounts it into api and worker at
# /etc/psa/research-allowlist.yaml). A host run from backend/ points at ../ops/. Unset or
# missing: every fetch is denied. The timeout covers every redirect hop; the body limit is
# in bytes (2 MiB).
# PSA_RESEARCH_ALLOWLIST_PATH=../ops/research-allowlist.yaml
PSA_RESEARCH_FETCH_TIMEOUT_S=10
PSA_RESEARCH_MAX_BYTES=2097152

# `make eval` (Story 7.6, evals/README.md): an isolated evaluation database, reset on every
# run, that must differ from PSA_DATABASE_URL (create it once: `createdb psa_eval`, grant
# psa_app as for psa). Cost rates are integer minor units of PSA_COST_CURRENCY.
# PSA_EVAL_DATABASE_URL=postgresql+psycopg://psa_app:change-me-app-local-only@127.0.0.1:5432/psa_eval
# PSA_EVAL_MIGRATIONS_DATABASE_URL=postgresql+psycopg://psa:change-me-local-only@127.0.0.1:5432/psa_eval
PSA_COST_PER_GPU_SECOND_MINOR=0
PSA_COST_PER_1K_TOKENS_MINOR=0
PSA_COST_CURRENCY=EUR

# Auth0 (README "Auth0 tenant setup"). These placeholders let the stack build, start and
# answer /healthz without a tenant; signing in needs your real EU tenant values in .env.
# The api gets AUTH0_DOMAIN and AUTH0_AUDIENCE as PSA_AUTH0_DOMAIN / PSA_AUTH0_AUDIENCE.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# The API identifier (Auth0 > APIs); access tokens are requested for this audience.
AUTH0_AUDIENCE=https://api.pre-sales-agent
AUTH0_CLIENT_ID=replace-with-your-client-id
AUTH0_CLIENT_SECRET=replace-with-your-client-secret
# Encrypts the session cookie. Generate your own: openssl rand -hex 32
AUTH0_SECRET=replace-with-output-of-openssl-rand-hex-32
# Only for backend/scripts/seed_auth0.py (README "Auth0 setup"): a Machine-to-Machine app
# authorized for the Auth0 Management API. Never used by the running app.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000

# Host-side tools (pytest, alembic, uvicorn outside compose) use these URLs.
# Keep them in sync by hand: users/passwords must match the values above and the port
# must match PSA_POSTGRES_PORT. The app and pytest connect as psa_app; Alembic as the owner.
PSA_DATABASE_URL=postgresql+psycopg://psa_app:change-me-app-local-only@localhost:5432/psa
PSA_MIGRATIONS_DATABASE_URL=postgresql+psycopg://psa:change-me-local-only@localhost:5432/psa
