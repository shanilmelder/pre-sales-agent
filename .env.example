# Copy to .env for the local stack (`cp .env.example .env`). Never commit .env.
# Local-only development values; production secrets live in the sops/age file (Story 1.2).

# Build version reported by GET /api/v1/health and /healthz
PSA_VERSION=0.1.0-local

# Postgres (compose `postgres` service)
# POSTGRES_USER and POSTGRES_PASSWORD are embedded unescaped in the api's database URL,
# so they must be URL-safe: no @ : / # % characters.
POSTGRES_USER=psa
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=psa
# Password of `psa_app`, the least-privileged role the api connects as (also URL-safe).
# Migrations run as POSTGRES_USER, the schema owner.
PSA_APP_DB_PASSWORD=change-me-app-local-only

# Host ports (bound to 127.0.0.1)
PSA_POSTGRES_PORT=5432
PSA_API_PORT=8000
PSA_WEB_PORT=3000

PSA_LOG_LEVEL=INFO

# Auth0 (README "Auth0 tenant setup"). These placeholders let the stack build, start and
# answer /healthz without a tenant; signing in needs your real EU tenant values in .env.
# The api gets AUTH0_DOMAIN and AUTH0_AUDIENCE as PSA_AUTH0_DOMAIN / PSA_AUTH0_AUDIENCE.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# The API identifier (Auth0 > APIs); access tokens are requested for this audience.
AUTH0_AUDIENCE=https://api.pre-sales-agent
AUTH0_CLIENT_ID=replace-with-your-client-id
AUTH0_CLIENT_SECRET=replace-with-your-client-secret
# Encrypts the session cookie. Generate your own: openssl rand -hex 32
AUTH0_SECRET=replace-with-output-of-openssl-rand-hex-32
APP_BASE_URL=http://localhost:3000

# Host-side tools (pytest, alembic, uvicorn outside compose) use these URLs.
# Keep them in sync by hand: users/passwords must match the values above and the port
# must match PSA_POSTGRES_PORT. The app and pytest connect as psa_app; Alembic as the owner.
PSA_DATABASE_URL=postgresql+psycopg://psa_app:change-me-app-local-only@localhost:5432/psa
PSA_MIGRATIONS_DATABASE_URL=postgresql+psycopg://psa:change-me-local-only@localhost:5432/psa
